# مفتاح Claude (الأفضل): من console.anthropic.com
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
# موديل Claude: claude-opus-5-5 (الأقوى) أو claude-sonnet-5-5
CLAUDE_MODEL="claude-opus-5-5"
# اختياري: ميزانية التفكير المعمّق (1024 فأكثر) لزيادة دقة حل المسائل
# CLAUDE_THINKING_BUDGET=8000

# احتياطي لو Claude مش متاح
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# الموديلات بالترتيب (الأقوى أولاً، وينزل للتالي تلقائياً لو فشل)
# GEMINI_MODELS="gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite"

# نطاقات الواجهة المسموح لها بنداء السيرفر (مثال GitHub Pages)، مفصولة بفواصل. الافتراضي *
# ALLOWED_ORIGINS="https://USERNAME.github.io"
APP_URL="MY_APP_URL"
